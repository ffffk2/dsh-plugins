{
  "name": "@local/dsh-token-usage",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "按 ZCode 口径统计模型 token 用量：指标条、52 周热力图、多模型趋势与模型占比",
  "license": "MIT",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "icon": "./icon.svg",
  "meta": {
    "title": "Token 统计",
    "description": "累计 Token、峰值、连续天数与最长会话，配 52 周活动热力图、近 7/30 日多模型趋势和模型占比。"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "icon.svg",
    "README.md",
    "locale/*.json"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  }
}
