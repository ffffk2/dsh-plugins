{
  "name": "@local/dsh-rewind",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "回到我发过的某条消息：撤回其后的对话上下文与工作区文件改动",
  "license": "MIT",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "icon": "./icon.svg",
  "meta": {
    "title": "对话回滚",
    "description": "回到我发过的某条消息：撤回其后的上下文与文件改动。"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "icon.svg",
    "README.md",
    "locale/*.json"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
